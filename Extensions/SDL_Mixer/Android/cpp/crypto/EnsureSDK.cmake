if(DEFINED ANDROID_PLATFORM_LEVEL)
    set(ofe_encrypt_api "${ANDROID_PLATFORM_LEVEL}")
else()
    string(REGEX REPLACE "^android-" "" ofe_encrypt_api "${ANDROID_PLATFORM}")
endif()
if(NOT ofe_encrypt_api MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Cannot determine the Android API level for OpenSSL")
endif()
get_filename_component(ofe_encrypt_version "${ofe_extensions}/_3rdLib/Encrypt-build/EncryptVersion.cmake" ABSOLUTE)
if(NOT EXISTS "${ofe_encrypt_version}")
    set(ofe_encrypt_version "${CMAKE_CURRENT_LIST_DIR}/../../EncryptVersion.cmake")
endif()
include("${ofe_encrypt_version}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ofe_encrypt_version}")
if(NOT DEFINED OFE_ENCRYPT_ROOT AND DEFINED ENV{OFE_ENCRYPT_ROOT})
    set(OFE_ENCRYPT_ROOT "$ENV{OFE_ENCRYPT_ROOT}" CACHE PATH "Existing Android OpenSSL SDK")
endif()
set(OFE_ENCRYPT_ROOT "${ofe_extensions}/_3rdLib/Encrypt-sdk-Android" CACHE PATH "Windows-version-matched Android OpenSSL SDK")
option(OFE_ENCRYPT_AUTO_DEPLOY "Prepare a missing or stale Android OpenSSL SDK" ON)
set(ofe_encrypt_ready FALSE)
if(EXISTS "${OFE_ENCRYPT_ROOT}/manifest.json")
    file(READ "${OFE_ENCRYPT_ROOT}/manifest.json" ofe_manifest)
    string(JSON ofe_version ERROR_VARIABLE ofe_version_error GET "${ofe_manifest}" version)
    string(JSON ofe_commit ERROR_VARIABLE ofe_commit_error GET "${ofe_manifest}" vcpkg_commit)
    string(JSON ofe_api ERROR_VARIABLE ofe_api_error GET "${ofe_manifest}" api)
    string(JSON ofe_abis ERROR_VARIABLE ofe_abis_error GET "${ofe_manifest}" abis)
    if(NOT ofe_abis_error AND ofe_abis MATCHES "\"${ANDROID_ABI}\""
       AND NOT ofe_version_error AND NOT ofe_commit_error AND NOT ofe_api_error
       AND ofe_version STREQUAL OFE_ENCRYPT_OPENSSL_VERSION AND ofe_commit STREQUAL OFE_ENCRYPT_VCPKG_COMMIT
       AND ofe_api EQUAL ofe_encrypt_api
       AND EXISTS "${OFE_ENCRYPT_ROOT}/${ANDROID_ABI}/lib/libcrypto.a"
       AND EXISTS "${OFE_ENCRYPT_ROOT}/${ANDROID_ABI}/include/openssl/evp.h")
        set(ofe_encrypt_ready TRUE)
    endif()
endif()
if(NOT ofe_encrypt_ready)
    if(NOT OFE_ENCRYPT_AUTO_DEPLOY)
        message(FATAL_ERROR "Android OpenSSL SDK must match ${ofe_encrypt_version} and API ${ofe_encrypt_api}; prepare OFE_ENCRYPT_ROOT or enable OFE_ENCRYPT_AUTO_DEPLOY")
    endif()
    find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
    file(MAKE_DIRECTORY "${OFE_ENCRYPT_ROOT}")
    file(LOCK "${OFE_ENCRYPT_ROOT}/.ofe-build.lock" GUARD PROCESS TIMEOUT 1800)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../../build_crypto_sdk.py"
        --ndk "${CMAKE_ANDROID_NDK}" --output "${OFE_ENCRYPT_ROOT}" --abi "${ANDROID_ABI}" --api "${ofe_encrypt_api}"
        RESULT_VARIABLE ofe_encrypt_result)
    if(NOT ofe_encrypt_result EQUAL 0)
        message(FATAL_ERROR "OpenSSL deployment failed; prepare the Android SDK under Linux/WSL using its matching NDK")
    endif()
    file(LOCK "${OFE_ENCRYPT_ROOT}/.ofe-build.lock" RELEASE)
endif()
set(OPENSSL_USE_STATIC_LIBS TRUE)
set(OPENSSL_INCLUDE_DIR "${OFE_ENCRYPT_ROOT}/${ANDROID_ABI}/include" CACHE PATH "" FORCE)
set(OPENSSL_CRYPTO_LIBRARY "${OFE_ENCRYPT_ROOT}/${ANDROID_ABI}/lib/libcrypto.a" CACHE FILEPATH "" FORCE)
# FindOpenSSL's host pkg-config probe must not add host compression libraries.
set(CMAKE_DISABLE_FIND_PACKAGE_PkgConfig TRUE)
set(PKG_CONFIG_FOUND FALSE)
set(_OPENSSL_STATIC_LIBRARIES "")
set(_OPENSSL_STATIC_LDFLAGS_OTHER "")
