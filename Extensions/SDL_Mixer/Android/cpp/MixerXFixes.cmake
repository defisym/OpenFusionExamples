# OFE's explicit, reproducible overlay for pinned Mixer X 72139aa.
# The PCM WAV seek path aligns offsets to one second instead of one sample frame.
# Keep the upstream checkout untouched and compile an identified corrected copy.
set(wav_source "${OFE_MIXERX_SOURCE}/src/codecs/music_wav.c")
file(READ "${wav_source}" wav_code)
set(broken "Sint64 sample_size = music->spec.freq * music->samplesize;")
string(FIND "${wav_code}" "${broken}" match)
if(match LESS 0)
    message(FATAL_ERROR "Mixer X WAV seek overlay needs review against the selected source")
endif()
string(REPLACE "${broken}" "Sint64 sample_size = music->samplesize; /* OFE: align to a sample frame, not a whole second. */" wav_code "${wav_code}")
set(corrected "${CMAKE_CURRENT_BINARY_DIR}/upstream-fixes/music_wav.c")
set(wav_code "/* Altered by OFE: fractional PCM WAV seek alignment. */\n${wav_code}")
set(existing "")
if(EXISTS "${corrected}")
    file(READ "${corrected}" existing)
endif()
if(NOT existing STREQUAL wav_code)
    file(WRITE "${corrected}" "${wav_code}")
endif()
get_target_property(mixer_sources SDL2_mixer_ext SOURCES)
list(REMOVE_ITEM mixer_sources "${wav_source}")
list(APPEND mixer_sources "${corrected}")
set_property(TARGET SDL2_mixer_ext PROPERTY SOURCES "${mixer_sources}")
