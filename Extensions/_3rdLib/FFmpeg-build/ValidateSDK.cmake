# Called for the installed SDK and for staging, before replacing an existing SDK.
function(ofe_validate_ffmpeg_sdk root result)
    set(${result} FALSE PARENT_SCOPE)
    foreach(component IN ITEMS avcodec avdevice avfilter avformat avutil swresample swscale)
        set(header "${root}/include/lib${component}/version_major.h")
        if(NOT EXISTS "${header}")
            set(header "${root}/include/lib${component}/version.h")
        endif()
        if(NOT EXISTS "${header}")
            set(OFE_FFMPEG_VALIDATION_ERROR "FFmpeg SDK is missing ${component} version headers: ${root}" PARENT_SCOPE)
            return()
        endif()
        string(TOUPPER "${component}" upper)
        file(STRINGS "${header}" version_line
            REGEX "^#[ \t]*define[ \t]+LIB${upper}_VERSION_MAJOR[ \t]+[0-9]+")
        if(NOT version_line MATCHES "LIB${upper}_VERSION_MAJOR[ \t]+([0-9]+)")
            set(OFE_FFMPEG_VALIDATION_ERROR "Cannot read LIB${upper}_VERSION_MAJOR from ${header}" PARENT_SCOPE)
            return()
        endif()
        set(major "${CMAKE_MATCH_1}")
        foreach(path IN ITEMS "include/lib${component}/${component}.h" "lib/${component}.lib" "bin/${component}-${major}.dll")
            if(NOT EXISTS "${root}/${path}")
                set(OFE_FFMPEG_VALIDATION_ERROR "FFmpeg SDK is missing ${path}; headers, import libraries and DLLs must match." PARENT_SCOPE)
                return()
            endif()
        endforeach()
        # These releases are Win32 only. Reject an accidentally selected x64 SDK.
        set(dll "${root}/bin/${component}-${major}.dll")
        file(READ "${dll}" offset_hex OFFSET 60 LIMIT 4 HEX)
        if(NOT offset_hex MATCHES "^[0-9a-fA-F]+$" OR NOT offset_hex MATCHES "^........$")
            set(OFE_FFMPEG_VALIDATION_ERROR "Invalid Windows DLL: ${dll}" PARENT_SCOPE)
            return()
        endif()
        string(SUBSTRING "${offset_hex}" 0 2 b0)
        string(SUBSTRING "${offset_hex}" 2 2 b1)
        string(SUBSTRING "${offset_hex}" 4 2 b2)
        string(SUBSTRING "${offset_hex}" 6 2 b3)
        math(EXPR pe_offset "0x${b3}${b2}${b1}${b0}")
        file(READ "${dll}" pe_header OFFSET ${pe_offset} LIMIT 6 HEX)
        if(NOT pe_header STREQUAL "504500004c01")
            set(OFE_FFMPEG_VALIDATION_ERROR "Expected a Win32 (x86) PE DLL: ${dll}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${result} TRUE PARENT_SCOPE)
endfunction()
