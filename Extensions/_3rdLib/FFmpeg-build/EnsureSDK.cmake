cmake_minimum_required(VERSION 3.21)
if(NOT OFE_ARCH STREQUAL "x86")
    message(FATAL_ERROR "The selected FFmpeg release provides Win32 (x86) packages only.")
endif()
get_filename_component(dependencies "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT OFE_FFMPEG_ROOT)
    set(OFE_FFMPEG_ROOT "${dependencies}/FFmpeg-sdk")
endif()
get_filename_component(OFE_FFMPEG_ROOT "${OFE_FFMPEG_ROOT}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/FFmpegVersion.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ValidateSDK.cmake")
string(LENGTH "${OFE_FFMPEG_SHA256}" hash_length)
if(NOT hash_length EQUAL 64 OR NOT OFE_FFMPEG_SHA256 MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "Set a valid archive SHA256 in FFmpegVersion.cmake.")
endif()
set(package "ffmpeg-n${OFE_FFMPEG_VERSION}-latest-win32-${OFE_FFMPEG_VARIANT}-${OFE_FFMPEG_VERSION}")
set(url "https://github.com/${OFE_FFMPEG_REPOSITORY}/releases/download/${OFE_FFMPEG_RELEASE}/${package}.zip")
set(signature "${url}|${OFE_FFMPEG_SHA256}")
foreach(script IN ITEMS EnsureSDK.cmake ValidateSDK.cmake FFmpegVersion.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${script}" hash)
    string(APPEND signature "|${hash}")
endforeach()
string(SHA256 signature "${signature}")
file(MAKE_DIRECTORY "${OFE_FFMPEG_ROOT}")
file(LOCK "${OFE_FFMPEG_ROOT}/.ofe-build.lock" GUARD PROCESS TIMEOUT 1800)
set(stamp "${OFE_FFMPEG_ROOT}/.ofe-sdk.stamp")
if(EXISTS "${stamp}")
    file(READ "${stamp}" previous)
    if(previous STREQUAL signature)
        ofe_validate_ffmpeg_sdk("${OFE_FFMPEG_ROOT}" valid)
        if(valid)
            message(STATUS "FFmpeg ${OFE_FFMPEG_VERSION} ${OFE_FFMPEG_VARIANT} SDK is up to date (x86).")
            return()
        endif()
        message(STATUS "Repairing incomplete FFmpeg SDK: ${OFE_FFMPEG_VALIDATION_ERROR}")
    endif()
endif()
set(work "${CMAKE_CURRENT_LIST_DIR}/out")
file(MAKE_DIRECTORY "${work}/downloads")
# Different SDK destinations still share the archive cache and staging area.
file(LOCK "${work}/.ofe-prepare.lock" GUARD PROCESS TIMEOUT 1800)
if(NOT OFE_FFMPEG_ARCHIVE)
    set(OFE_FFMPEG_ARCHIVE "${work}/downloads/${OFE_FFMPEG_SHA256}.zip")
    if(NOT EXISTS "${OFE_FFMPEG_ARCHIVE}")
        message(STATUS "Downloading ${url}")
        file(DOWNLOAD "${url}" "${OFE_FFMPEG_ARCHIVE}.part"
            STATUS status TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 60 SHOW_PROGRESS)
        list(GET status 0 result)
        if(NOT result EQUAL 0)
            file(REMOVE "${OFE_FFMPEG_ARCHIVE}.part")
            message(FATAL_ERROR "FFmpeg download failed: ${status}")
        endif()
        file(RENAME "${OFE_FFMPEG_ARCHIVE}.part" "${OFE_FFMPEG_ARCHIVE}")
    endif()
endif()
file(SHA256 "${OFE_FFMPEG_ARCHIVE}" actual_hash)
if(NOT actual_hash STREQUAL OFE_FFMPEG_SHA256)
    message(FATAL_ERROR "FFmpeg archive SHA256 mismatch: ${OFE_FFMPEG_ARCHIVE}. Expected ${OFE_FFMPEG_SHA256}, got ${actual_hash}. The mutable latest release may have changed; update FFmpegVersion.cmake deliberately or supply the original archive with OFE_FFMPEG_ARCHIVE.")
endif()
set(staging "${work}/extract-${OFE_FFMPEG_SHA256}")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${staging}")
file(ARCHIVE_EXTRACT INPUT "${OFE_FFMPEG_ARCHIVE}" DESTINATION "${staging}")
set(sdk "${staging}/${package}")
ofe_validate_ffmpeg_sdk("${sdk}" valid)
if(NOT valid)
    message(FATAL_ERROR "${OFE_FFMPEG_VALIDATION_ERROR}")
endif()
# Validation succeeds before replacing any existing SDK files. Keep all upstream
# package files, including the license, build configuration and command-line tools.
file(REMOVE "${stamp}")
foreach(directory IN ITEMS include lib bin)
    file(REMOVE_RECURSE "${OFE_FFMPEG_ROOT}/${directory}")
endforeach()
file(COPY "${sdk}/" DESTINATION "${OFE_FFMPEG_ROOT}")
file(WRITE "${stamp}" "${signature}")
file(REMOVE_RECURSE "${staging}")
message(STATUS "Prepared FFmpeg ${OFE_FFMPEG_VERSION} ${OFE_FFMPEG_VARIANT} SDK: ${OFE_FFMPEG_ROOT}")
