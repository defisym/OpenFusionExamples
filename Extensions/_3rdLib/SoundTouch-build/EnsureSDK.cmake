cmake_minimum_required(VERSION 3.21)
if(NOT OFE_ARCH MATCHES "^(x86|x64)$")
    message(FATAL_ERROR "The SoundTouch SDK supports x86 and x64.")
endif()
get_filename_component(OFE_REPO_ROOT "${OFE_REPO_ROOT}" ABSOLUTE)
get_filename_component(OFE_SOUND_ROOT "${OFE_SOUND_ROOT}" ABSOLUTE)
set(source "${OFE_REPO_ROOT}/Extensions/_3rdLib/SoundTouch-build")
if(NOT OFE_GENERATOR)
    set(OFE_GENERATOR "Visual Studio 17 2022")
endif()
# Reject unsupported generators before downloading or building dependencies.
execute_process(COMMAND "${CMAKE_COMMAND}" -E capabilities
    OUTPUT_VARIABLE capabilities RESULT_VARIABLE capability_result)
if(NOT capability_result EQUAL 0)
    message(FATAL_ERROR "Cannot query CMake generators.")
endif()
string(JSON generator_count LENGTH "${capabilities}" generators)
set(generator_supported FALSE)
math(EXPR generator_last "${generator_count} - 1")
foreach(index RANGE 0 ${generator_last})
    string(JSON generator_name GET "${capabilities}" generators ${index} name)
    if(generator_name STREQUAL OFE_GENERATOR)
        set(generator_supported TRUE)
    endif()
endforeach()
if(NOT generator_supported)
    message(FATAL_ERROR "CMake ${CMAKE_VERSION} does not support '${OFE_GENERATOR}'. VS 2026 requires CMake 4.2 or newer; select a newer CMake executable in the SDK properties.")
endif()
if(NOT OFE_BUILD_DIR)
    # CMake cannot reuse a build tree with a different generator or VS instance.
    string(SHA256 build_key "${OFE_GENERATOR}|${OFE_GENERATOR_INSTANCE}|${OFE_TOOLSET}|${OFE_TOOLCHAIN_FILE}")
    string(SUBSTRING "${build_key}" 0 12 build_key)
    set(OFE_BUILD_DIR "${source}/out/${OFE_ARCH}-${build_key}")
endif()
if(NOT OFE_GIT_EXECUTABLE)
    find_program(OFE_GIT_EXECUTABLE NAMES git REQUIRED)
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE errors
        ECHO_OUTPUT_VARIABLE ECHO_ERROR_VARIABLE)
    file(APPEND "${build_log}" "\nCommand: ${ARGV}\n${output}${errors}\nResult: ${result}\n")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "SoundTouch SDK command failed (${result}). See ${build_log}. Command: ${ARGV}")
    endif()
endfunction()
# Serialize SoundTouch SDK preparation across builds and architectures.
file(MAKE_DIRECTORY "${OFE_SOUND_ROOT}")
file(LOCK "${OFE_SOUND_ROOT}/.ofe-build.lock" GUARD PROCESS TIMEOUT 1800)
set(build_log "${OFE_SOUND_ROOT}/.ofe-build.log")
file(WRITE "${build_log}" "CMake ${CMAKE_VERSION}; generator: ${OFE_GENERATOR}\n")
message(STATUS "Dependency build log: ${build_log}")
# Different dependency projects can initialize submodules concurrently in VS.
# Git's parent-repository config must only be updated by one initializer.
function(init_submodules)
    file(LOCK "${OFE_REPO_ROOT}/Extensions/_3rdLib/.ofe-submodules.lock" GUARD FUNCTION TIMEOUT 1800)
    run("${OFE_GIT_EXECUTABLE}" -C "${OFE_REPO_ROOT}" submodule update --init --depth 1
        Extensions/_3rdLib/SoundTouch)
endfunction()
init_submodules()
set(signature "${OFE_ARCH}|${OFE_GENERATOR}|${OFE_TOOLSET}|${OFE_TOOLCHAIN_FILE}|${OFE_GENERATOR_INSTANCE}")
foreach(module IN ITEMS SoundTouch)
    set(module_source "${OFE_REPO_ROOT}/Extensions/_3rdLib/${module}")
    execute_process(COMMAND "${OFE_GIT_EXECUTABLE}" -C "${module_source}" rev-parse HEAD
        OUTPUT_VARIABLE revision RESULT_VARIABLE result OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot read ${module} revision.")
    endif()
    execute_process(COMMAND "${OFE_GIT_EXECUTABLE}" -C "${module_source}" diff --no-ext-diff --binary HEAD
        OUTPUT_VARIABLE changes RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot check local changes in ${module}.")
    endif()
    string(APPEND signature "|${revision}|${changes}")
endforeach()
foreach(script IN ITEMS CMakeLists.txt EnsureSDK.cmake)
    file(SHA256 "${source}/${script}" hash)
    string(APPEND signature "|${hash}")
endforeach()
string(SHA256 signature "${signature}")
set(complete TRUE)
foreach(path IN ITEMS include/SoundTouchDLL.h lib/${OFE_ARCH}/SoundTouchDLL.dll)
    if(NOT EXISTS "${OFE_SOUND_ROOT}/${path}")
        set(complete FALSE)
    endif()
endforeach()
foreach(name IN ITEMS SoundTouchDLL)
    if(NOT EXISTS "${OFE_SOUND_ROOT}/lib/${OFE_ARCH}/${name}.lib"
       AND NOT EXISTS "${OFE_SOUND_ROOT}/lib/${OFE_ARCH}/lib${name}.dll.a")
        set(complete FALSE)
    endif()
endforeach()
set(stamp "${OFE_SOUND_ROOT}/lib/${OFE_ARCH}/.ofe-sdk.stamp")
if(complete AND EXISTS "${stamp}")
    file(READ "${stamp}" previous)
    if(previous STREQUAL signature)
        message(STATUS "SoundTouch SDK is up to date (${OFE_ARCH}).")
        return()
    endif()
endif()
set(configure "${CMAKE_COMMAND}" -S "${source}" -B "${OFE_BUILD_DIR}" -G "${OFE_GENERATOR}"
    "-DCMAKE_INSTALL_PREFIX:PATH=${OFE_SOUND_ROOT}")
if(OFE_GENERATOR MATCHES "Visual Studio")
    if(OFE_ARCH STREQUAL "x86")
        list(APPEND configure -A Win32)
    else()
        list(APPEND configure -A x64)
    endif()
    if(OFE_TOOLSET)
        list(APPEND configure -T "${OFE_TOOLSET}")
    endif()
    if(OFE_GENERATOR_INSTANCE)
        get_filename_component(instance "${OFE_GENERATOR_INSTANCE}" REALPATH)
        list(APPEND configure "-DCMAKE_GENERATOR_INSTANCE:PATH=${instance}")
    endif()
endif()
if(OFE_TOOLCHAIN_FILE)
    list(APPEND configure "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${OFE_TOOLCHAIN_FILE}")
endif()
run(${configure})
run("${CMAKE_COMMAND}" --build "${OFE_BUILD_DIR}" --config Release --target SoundTouchDLL --parallel 4)
run("${CMAKE_COMMAND}" --install "${OFE_BUILD_DIR}" --config Release)
file(WRITE "${stamp}" "${signature}")
