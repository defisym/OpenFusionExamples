cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/EncryptVersion.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ValidateSDK.cmake")
if(NOT OFE_ARCH MATCHES "^(x86|x64)$")
    message(FATAL_ERROR "EncryptDependencies supports x86 and x64.")
endif()

# Ordinary VS builds consume our SDK; source builds are an explicit opt-in.
# User-supplied archives/URLs retain precedence over the repository defaults.
if(NOT OFE_BUILD_FROM_SOURCE AND NOT OFE_PREBUILT_URL AND NOT OFE_PREBUILT_ARCHIVE)
    if(OFE_PLATFORM_TOOLSET AND NOT OFE_PLATFORM_TOOLSET STREQUAL "v143")
        message(FATAL_ERROR "The prebuilt OpenSSL SDK uses v143. Set OfeEncryptBuildFromSource=true for another toolset.")
    endif()
    set(OFE_PREBUILT_URL "${OFE_ENCRYPT_SDK_URL}/openssl-${OFE_ARCH}.zip")
    if(OFE_ARCH STREQUAL "x86")
        set(OFE_PREBUILT_SHA256 "${OFE_ENCRYPT_SDK_X86_SHA256}")
    else()
        set(OFE_PREBUILT_SHA256 "${OFE_ENCRYPT_SDK_X64_SHA256}")
    endif()
endif()

if(NOT OFE_OPENSSL_ROOT)
    set(OFE_OPENSSL_ROOT "${CMAKE_CURRENT_LIST_DIR}/../Encrypt-sdk/${OFE_ARCH}")
endif()
get_filename_component(OFE_OPENSSL_ROOT "${OFE_OPENSSL_ROOT}" ABSOLUTE)
if(NOT OFE_WORK_DIR)
    set(OFE_WORK_DIR "${CMAKE_CURRENT_LIST_DIR}/out")
endif()
get_filename_component(OFE_WORK_DIR "${OFE_WORK_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${OFE_WORK_DIR}")
file(LOCK "${OFE_WORK_DIR}/.ofe-prepare.lock" GUARD PROCESS TIMEOUT 1800)
set(log "${OFE_WORK_DIR}/build-${OFE_ARCH}.log")
file(WRITE "${log}" "Encrypt SDK preparation: ${OFE_OPENSSL_ROOT}\n")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE errors ENCODING UTF-8
        ECHO_OUTPUT_VARIABLE ECHO_ERROR_VARIABLE)
    file(APPEND "${log}" "\n${ARGV}\n${output}${errors}\nResult: ${result}\n")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Encrypt dependency command failed (${result}). See ${log}")
    endif()
endfunction()
set(signature "${OFE_ARCH}|${OFE_ENCRYPT_VCPKG_COMMIT}|${OFE_PLATFORM_TOOLSET}|${OFE_VS_INSTANCE}|${OFE_PREBUILT_URL}|${OFE_PREBUILT_SHA256}")
if(OFE_PREBUILT_ARCHIVE)
    file(SHA256 "${OFE_PREBUILT_ARCHIVE}" local_hash)
    string(APPEND signature "|${local_hash}")
endif()
foreach(script IN ITEMS EncryptVersion.cmake vcpkg.json EnsureSDK.cmake ValidateSDK.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${script}" hash)
    string(APPEND signature "|${hash}")
endforeach()
string(SHA256 signature "${signature}")
set(stamp "${OFE_OPENSSL_ROOT}/.ofe-sdk.stamp")
if(EXISTS "${stamp}")
    file(READ "${stamp}" previous)
    ofe_validate_encrypt_sdk("${OFE_OPENSSL_ROOT}" "${OFE_ARCH}" valid)
    if(valid AND previous STREQUAL signature)
        message(STATUS "OpenSSL SDK is up to date (${OFE_ARCH}).")
        return()
    endif()
endif()
set(triplet "${OFE_ARCH}-windows-static-md")
if(OFE_PREBUILT_URL OR OFE_PREBUILT_ARCHIVE)
    string(LENGTH "${OFE_PREBUILT_SHA256}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT OFE_PREBUILT_SHA256 MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Prebuilt OpenSSL SDKs require OFE_PREBUILT_SHA256.")
    endif()
    string(TOLOWER "${OFE_PREBUILT_SHA256}" OFE_PREBUILT_SHA256)
    if(NOT OFE_PREBUILT_ARCHIVE)
        file(MAKE_DIRECTORY "${OFE_WORK_DIR}/downloads")
        set(OFE_PREBUILT_ARCHIVE "${OFE_WORK_DIR}/downloads/${OFE_PREBUILT_SHA256}.zip")
        if(NOT EXISTS "${OFE_PREBUILT_ARCHIVE}")
            message(STATUS "Downloading ${OFE_PREBUILT_URL}")
            file(DOWNLOAD "${OFE_PREBUILT_URL}" "${OFE_PREBUILT_ARCHIVE}.part"
                STATUS status TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 60 SHOW_PROGRESS)
            list(GET status 0 result)
            if(NOT result EQUAL 0)
                file(REMOVE "${OFE_PREBUILT_ARCHIVE}.part")
                message(FATAL_ERROR "OpenSSL SDK download failed: ${status}")
            endif()
            file(RENAME "${OFE_PREBUILT_ARCHIVE}.part" "${OFE_PREBUILT_ARCHIVE}")
        endif()
    endif()
    file(SHA256 "${OFE_PREBUILT_ARCHIVE}" actual)
    if(NOT actual STREQUAL OFE_PREBUILT_SHA256)
        message(FATAL_ERROR "OpenSSL SDK archive SHA256 mismatch. Expected ${OFE_PREBUILT_SHA256}, got ${actual}")
    endif()
    set(prepared "${OFE_WORK_DIR}/prebuilt-${OFE_ARCH}")
    file(REMOVE_RECURSE "${prepared}")
    file(MAKE_DIRECTORY "${prepared}")
    file(ARCHIVE_EXTRACT INPUT "${OFE_PREBUILT_ARCHIVE}" DESTINATION "${prepared}")
else()
    if(NOT CMAKE_HOST_WIN32)
        message(FATAL_ERROR "Source preparation requires Windows + Visual Studio. A prebuilt archive can be staged on any host.")
    endif()
    find_program(git NAMES git REQUIRED)
    set(vcpkg "${OFE_WORK_DIR}/vcpkg")
    if(NOT EXISTS "${vcpkg}/.git")
        file(MAKE_DIRECTORY "${vcpkg}")
        run("${git}" -C "${vcpkg}" init)
        run("${git}" -C "${vcpkg}" remote add origin "${OFE_ENCRYPT_VCPKG_REPOSITORY}")
    endif()
    execute_process(COMMAND "${git}" -C "${vcpkg}" rev-parse HEAD
        OUTPUT_VARIABLE current ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT current STREQUAL OFE_ENCRYPT_VCPKG_COMMIT)
        execute_process(COMMAND "${git}" -C "${vcpkg}" diff --quiet RESULT_VARIABLE dirty)
        if(dirty EQUAL 1)
            message(FATAL_ERROR "Managed vcpkg has local tracked changes: ${vcpkg}")
        endif()
        run("${git}" -C "${vcpkg}" fetch --depth 1 origin "${OFE_ENCRYPT_VCPKG_COMMIT}")
        run("${git}" -C "${vcpkg}" checkout --detach "${OFE_ENCRYPT_VCPKG_COMMIT}")
    endif()
    if(NOT EXISTS "${vcpkg}/vcpkg.exe")
        run(cmd /c call "${vcpkg}/bootstrap-vcpkg.bat" -disableMetrics)
    endif()
    set(overlays "${OFE_WORK_DIR}/triplets")
    file(MAKE_DIRECTORY "${overlays}")
    set(triplet_body "set(VCPKG_TARGET_ARCHITECTURE ${OFE_ARCH})\nset(VCPKG_CRT_LINKAGE dynamic)\nset(VCPKG_LIBRARY_LINKAGE static)\n")
    if(OFE_PLATFORM_TOOLSET)
        if(NOT OFE_PLATFORM_TOOLSET MATCHES "^v[0-9]+$")
            message(FATAL_ERROR "Unsupported MSVC toolset: ${OFE_PLATFORM_TOOLSET}")
        endif()
        string(APPEND triplet_body "set(VCPKG_PLATFORM_TOOLSET ${OFE_PLATFORM_TOOLSET})\n")
    endif()
    file(WRITE "${overlays}/${triplet}.cmake" "${triplet_body}")
    set(install "${vcpkg}/vcpkg.exe" install "--vcpkg-root=${vcpkg}" "--triplet=${triplet}"
        "--x-manifest-root=${CMAKE_CURRENT_LIST_DIR}"
        "--x-install-root=${OFE_WORK_DIR}/installed"
        "--overlay-triplets=${overlays}" --disable-metrics)
    if(OFE_VS_INSTANCE)
        get_filename_component(instance "${OFE_VS_INSTANCE}" REALPATH)
        run("${CMAKE_COMMAND}" -E env "VCPKG_VISUAL_STUDIO_PATH=${instance}" ${install})
    else()
        run(${install})
    endif()
    set(prepared "${OFE_WORK_DIR}/installed/${triplet}")
    file(WRITE "${prepared}/ofe-encryption-sdk.json"
        "{\"arch\":\"${OFE_ARCH}\",\"version\":\"${OFE_ENCRYPT_OPENSSL_VERSION}\",\"linkage\":\"static\",\"crt\":\"dynamic\",\"vcpkg_commit\":\"${OFE_ENCRYPT_VCPKG_COMMIT}\"}\n")
endif()
ofe_validate_encrypt_sdk("${prepared}" "${OFE_ARCH}" valid)
if(NOT valid)
    message(FATAL_ERROR "${OFE_ENCRYPT_VALIDATION_ERROR}")
endif()
# Stage and validate before replacing the previous usable SDK.
set(staging "${OFE_OPENSSL_ROOT}.new")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${staging}")
file(COPY "${prepared}/" DESTINATION "${staging}")
file(WRITE "${staging}/.ofe-sdk.stamp" "${signature}")
set(backup "${OFE_OPENSSL_ROOT}.previous")
file(REMOVE_RECURSE "${backup}")
if(EXISTS "${OFE_OPENSSL_ROOT}")
    file(RENAME "${OFE_OPENSSL_ROOT}" "${backup}")
endif()
file(RENAME "${staging}" "${OFE_OPENSSL_ROOT}" RESULT error)
if(error)
    if(EXISTS "${backup}")
        file(RENAME "${backup}" "${OFE_OPENSSL_ROOT}")
    endif()
    message(FATAL_ERROR "Cannot install OpenSSL SDK: ${error}")
endif()
file(REMOVE_RECURSE "${backup}")
message(STATUS "Prepared OpenSSL ${OFE_ENCRYPT_OPENSSL_VERSION} SDK: ${OFE_OPENSSL_ROOT}")
