# Managed/prebuilt SDKs share this layout and manifest. Explicit external SDKs
# can still opt out of preparation through OfeAutoBuildEncrypt=false.
function(ofe_validate_encrypt_sdk root arch result)
    set(${result} FALSE PARENT_SCOPE)
    foreach(path IN ITEMS include/openssl/evp.h include/openssl/opensslv.h
            lib/libcrypto.lib debug/lib/libcrypto.lib ofe-encryption-sdk.json)
        if(NOT EXISTS "${root}/${path}" OR IS_DIRECTORY "${root}/${path}")
            set(OFE_ENCRYPT_VALIDATION_ERROR "Missing OpenSSL SDK file: ${root}/${path}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    file(READ "${root}/ofe-encryption-sdk.json" metadata)
    foreach(field IN ITEMS arch version linkage crt)
        string(JSON value ERROR_VARIABLE error GET "${metadata}" ${field})
        if(error)
            set(OFE_ENCRYPT_VALIDATION_ERROR "Invalid OpenSSL SDK manifest: ${field}" PARENT_SCOPE)
            return()
        endif()
        set(sdk_${field} "${value}")
    endforeach()
    if(NOT sdk_arch STREQUAL arch OR NOT sdk_version STREQUAL OFE_ENCRYPT_OPENSSL_VERSION
            OR NOT sdk_linkage STREQUAL "static" OR NOT sdk_crt STREQUAL "dynamic")
        set(OFE_ENCRYPT_VALIDATION_ERROR "OpenSSL SDK must be ${arch}, OpenSSL ${OFE_ENCRYPT_OPENSSL_VERSION}, static libraries with /MD and /MDd." PARENT_SCOPE)
        return()
    endif()
    file(READ "${root}/include/openssl/opensslv.h" version_header)
    string(REPLACE "." "\\." version_pattern "${OFE_ENCRYPT_OPENSSL_VERSION}")
    if(NOT version_header MATCHES "OPENSSL_VERSION_STR[ \t]+\"${version_pattern}\"")
        set(OFE_ENCRYPT_VALIDATION_ERROR "OpenSSL SDK header version does not match its manifest." PARENT_SCOPE)
        return()
    endif()
    set(licensed FALSE)
    foreach(path IN ITEMS share/openssl/copyright LICENSE.txt LICENSE)
        if(EXISTS "${root}/${path}" AND NOT IS_DIRECTORY "${root}/${path}")
            set(licensed TRUE)
        endif()
    endforeach()
    if(NOT licensed)
        set(OFE_ENCRYPT_VALIDATION_ERROR "OpenSSL SDK license is missing." PARENT_SCOPE)
        return()
    endif()
    foreach(path IN ITEMS lib/libcrypto.lib debug/lib/libcrypto.lib)
        file(READ "${root}/${path}" magic LIMIT 8 HEX)
        if(NOT magic STREQUAL "213c617263683e0a")
            set(OFE_ENCRYPT_VALIDATION_ERROR "Not a COFF library archive: ${root}/${path}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${result} TRUE PARENT_SCOPE)
    set(OFE_ENCRYPT_VALIDATION_ERROR "" PARENT_SCOPE)
endfunction()
