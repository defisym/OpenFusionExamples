cmake_minimum_required(VERSION 3.21)
if(NOT OFE_ARCH MATCHES "^(x86|x64)$")
    message(FATAL_ERROR "The SDL SDK supports x86 and x64.")
endif()
get_filename_component(OFE_REPO_ROOT "${OFE_REPO_ROOT}" ABSOLUTE)
get_filename_component(OFE_SDL_ROOT "${OFE_SDL_ROOT}" ABSOLUTE)
set(source "${OFE_REPO_ROOT}/Extensions/_3rdLib/SDL-build")
if(NOT OFE_GENERATOR)
    set(OFE_GENERATOR "Visual Studio 17 2022")
endif()
if(NOT OFE_BUILD_DIR)
    set(OFE_BUILD_DIR "${source}/out/vs-${OFE_ARCH}")
endif()
if(NOT OFE_GIT_EXECUTABLE)
    find_program(OFE_GIT_EXECUTABLE NAMES git REQUIRED)
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "SDL SDK command failed (${result}): ${ARGV}")
    endif()
endfunction()
# Both plugins and architectures share the SDK headers. Serialize preparation.
file(MAKE_DIRECTORY "${OFE_SDL_ROOT}")
file(LOCK "${OFE_SDL_ROOT}/.ofe-build.lock" GUARD PROCESS TIMEOUT 1800)
# Different dependency projects can initialize submodules concurrently in VS.
# Git's parent-repository config must only be updated by one initializer.
function(init_submodules)
    file(LOCK "${OFE_REPO_ROOT}/Extensions/_3rdLib/.ofe-submodules.lock" GUARD FUNCTION TIMEOUT 1800)
    run("${OFE_GIT_EXECUTABLE}" -C "${OFE_REPO_ROOT}" submodule update --init --depth 1
        Extensions/_3rdLib/SDL2 Extensions/_3rdLib/SDL-Mixer-X)
endfunction()
init_submodules()
set(signature "${OFE_ARCH}|${OFE_GENERATOR}|${OFE_TOOLSET}|${OFE_TOOLCHAIN_FILE}|${OFE_GENERATOR_INSTANCE}")
foreach(module IN ITEMS SDL2 SDL-Mixer-X)
    set(module_source "${OFE_REPO_ROOT}/Extensions/_3rdLib/${module}")
    execute_process(COMMAND "${OFE_GIT_EXECUTABLE}" -C "${module_source}" rev-parse HEAD
        OUTPUT_VARIABLE revision RESULT_VARIABLE result OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot read ${module} revision.")
    endif()
    execute_process(COMMAND "${OFE_GIT_EXECUTABLE}" -C "${module_source}" diff --no-ext-diff --binary HEAD
        OUTPUT_VARIABLE changes RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot check local changes in ${module}.")
    endif()
    string(APPEND signature "|${revision}|${changes}")
endforeach()
foreach(script IN ITEMS CMakeLists.txt StageSDK.cmake EnsureSDK.cmake)
    file(SHA256 "${source}/${script}" hash)
    string(APPEND signature "|${hash}")
endforeach()
string(SHA256 signature "${signature}")
set(complete TRUE)
foreach(path IN ITEMS include/SDL.h include/SDL_mixer.h lib/${OFE_ARCH}/SDL2.dll lib/${OFE_ARCH}/SDL2_mixer_ext.dll)
    if(NOT EXISTS "${OFE_SDL_ROOT}/${path}")
        set(complete FALSE)
    endif()
endforeach()
foreach(name IN ITEMS SDL2 SDL2_mixer_ext)
    if(NOT EXISTS "${OFE_SDL_ROOT}/lib/${OFE_ARCH}/${name}.lib"
       AND NOT EXISTS "${OFE_SDL_ROOT}/lib/${OFE_ARCH}/lib${name}.dll.a")
        set(complete FALSE)
    endif()
endforeach()
set(stamp "${OFE_SDL_ROOT}/lib/${OFE_ARCH}/.ofe-sdk.stamp")
if(complete AND EXISTS "${stamp}")
    file(READ "${stamp}" previous)
    if(previous STREQUAL signature)
        message(STATUS "SDL SDK is up to date (${OFE_ARCH}).")
        return()
    endif()
endif()
set(configure "${CMAKE_COMMAND}" -S "${source}" -B "${OFE_BUILD_DIR}" -G "${OFE_GENERATOR}"
    "-DOFE_SDL_SDK_ROOT:PATH=${OFE_SDL_ROOT}")
if(OFE_GENERATOR MATCHES "Visual Studio")
    if(OFE_ARCH STREQUAL "x86")
        list(APPEND configure -A Win32)
    else()
        list(APPEND configure -A x64)
    endif()
    if(OFE_TOOLSET)
        list(APPEND configure -T "${OFE_TOOLSET}")
    endif()
    if(OFE_GENERATOR_INSTANCE)
        get_filename_component(instance "${OFE_GENERATOR_INSTANCE}" REALPATH)
        list(APPEND configure "-DCMAKE_GENERATOR_INSTANCE:PATH=${instance}")
    endif()
endif()
if(OFE_TOOLCHAIN_FILE)
    list(APPEND configure "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${OFE_TOOLCHAIN_FILE}")
endif()
run(${configure})
run("${CMAKE_COMMAND}" --build "${OFE_BUILD_DIR}" --config Release)
file(WRITE "${stamp}" "${signature}")
