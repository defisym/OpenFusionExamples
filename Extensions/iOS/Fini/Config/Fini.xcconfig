// Fini-owned standalone project. SDK code stays in the user's licensed export.
FINI_RUNTIME_ROOT = $(SRCROOT)/SDK
FINI_OPENSSL_BASE = $(SRCROOT)/../../../work/mobile-encryption/openssl/ios
FINI_OUTPUT_ROOT = $(SRCROOT)/../../../work/fini-ios
#include? "Local.xcconfig"

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_CXX_LIBRARY = libc++
CLANG_ENABLE_OBJC_ARC = NO
GCC_ENABLE_CPP_EXCEPTIONS = YES
GCC_ENABLE_OBJC_EXCEPTIONS = YES
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) _FILE_OFFSET_BITS=64
GCC_PRECOMPILE_PREFIX_HEADER = NO
CODE_SIGNING_ALLOWED = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO

FINI_OPENSSL_ROOT[sdk=iphoneos*] = $(FINI_OPENSSL_BASE)/iphoneos-$(CURRENT_ARCH)
FINI_OPENSSL_ROOT[sdk=iphonesimulator*] = $(FINI_OPENSSL_BASE)/iphonesimulator-$(CURRENT_ARCH)
HEADER_SEARCH_PATHS = $(inherited) "$(FINI_RUNTIME_ROOT)/Classes/**" "$(SRCROOT)/../../_DeLib"
