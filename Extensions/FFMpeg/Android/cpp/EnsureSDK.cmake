# Android deployment uses the same release selection as the Windows SDK.
get_filename_component(ofe_version_file "${CMAKE_CURRENT_LIST_DIR}/../../../_3rdLib/FFmpeg-build/FFmpegVersion.cmake" ABSOLUTE)
if(NOT EXISTS "${ofe_version_file}")
    set(ofe_version_file "${CMAKE_CURRENT_LIST_DIR}/../FFmpegVersion.cmake")
endif()
include("${ofe_version_file}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ofe_version_file}")
if(NOT OFE_FFMPEG_ROOT)
    get_filename_component(OFE_FFMPEG_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../_3rdLib/FFmpeg-sdk-Android" ABSOLUTE)
    set(OFE_FFMPEG_ROOT "${OFE_FFMPEG_ROOT}" CACHE PATH "FFmpeg Android SDK root" FORCE)
endif()
option(OFE_FFMPEG_AUTO_DEPLOY "Build a missing or stale Android SDK from the shared FFmpeg version" ON)
set(ofe_sdk_valid FALSE)
if(EXISTS "${OFE_FFMPEG_ROOT}/manifest.json")
    file(READ "${OFE_FFMPEG_ROOT}/manifest.json" ofe_manifest)
    string(JSON ofe_version ERROR_VARIABLE ofe_version_error GET "${ofe_manifest}" version)
    string(JSON ofe_hash ERROR_VARIABLE ofe_hash_error GET "${ofe_manifest}" source_sha256)
    if(NOT ofe_version_error AND NOT ofe_hash_error AND ofe_version STREQUAL OFE_FFMPEG_VERSION AND ofe_hash STREQUAL OFE_FFMPEG_SOURCE_SHA256)
        set(ofe_sdk_valid TRUE)
        string(JSON ofe_abis ERROR_VARIABLE ofe_abis_error GET "${ofe_manifest}" abis)
        if(ofe_abis_error OR NOT ofe_abis MATCHES "\"${ANDROID_ABI}\"")
            set(ofe_sdk_valid FALSE)
        endif()
        foreach(component avcodec avformat avutil swscale swresample avfilter)
            if(NOT EXISTS "${OFE_FFMPEG_ROOT}/${ANDROID_ABI}/lib/lib${component}.so" OR
               NOT EXISTS "${OFE_FFMPEG_ROOT}/${ANDROID_ABI}/include/lib${component}/version.h")
                set(ofe_sdk_valid FALSE)
            endif()
        endforeach()
    endif()
endif()
if(NOT ofe_sdk_valid)
    if(NOT OFE_FFMPEG_AUTO_DEPLOY)
        message(FATAL_ERROR "FFmpeg Android SDK must match ${ofe_version_file}; enable OFE_FFMPEG_AUTO_DEPLOY or rebuild ${OFE_FFMPEG_ROOT}.")
    endif()
    find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
    # Serialize all ABI configurations targeting the same SDK/cache.
    file(MAKE_DIRECTORY "${OFE_FFMPEG_ROOT}")
    file(LOCK "${OFE_FFMPEG_ROOT}/.ofe-build.lock" GUARD PROCESS TIMEOUT 1800)
    message(STATUS "Preparing Android FFmpeg ${OFE_FFMPEG_VERSION} for ${ANDROID_ABI}: ${OFE_FFMPEG_ROOT}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../build_sdk.py"
        --ndk "${CMAKE_ANDROID_NDK}" --output "${OFE_FFMPEG_ROOT}"
        --cache "${OFE_FFMPEG_ROOT}/.build" --abi "${ANDROID_ABI}"
        RESULT_VARIABLE ofe_sdk_result)
    if(NOT ofe_sdk_result EQUAL 0)
        message(FATAL_ERROR "FFmpeg Android deployment failed. Build under Linux/WSL with its NDK, then set OFE_FFMPEG_ROOT to that SDK on Windows.")
    endif()
    file(LOCK "${OFE_FFMPEG_ROOT}/.ofe-build.lock" RELEASE)
endif()
